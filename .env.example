# ===========================================
# Slack Personal Proxy - Environment Variables
# ===========================================

# --- Slack Authentication (pick one method) ---

# Method A: Cookie-based (personal use)
# Get these from Chrome DevTools on app.slack.com
SLACK_COOKIE=xoxd-your-cookie-here
SLACK_TOKEN=xoxc-your-token-here

# Method B: Bot token (approved Slack app)
# SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# --- API Security ---

# API key for authenticating requests to this proxy
API_KEY=your-secure-api-key-here

# --- Server ---

PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# --- Rate Limiting ---

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# --- Caching ---

ENABLE_CACHING=true
CHANNEL_CACHE_TTL_SECONDS=300
USER_CACHE_TTL_SECONDS=300
THREAD_CACHE_TTL_SECONDS=120
HEALTH_CACHE_TTL_SECONDS=300

# --- Pagination ---

MAX_PAGINATION_CALLS=10

# --- Whitelist (comma-separated) ---
# Write whitelist gates POST/send operations only. Reads are unrestricted.
# When empty, all writes are allowed (open mode).

ALLOWED_WRITE_CHANNELS=
# Accepts user IDs (U...), usernames, or DM channel IDs (D...).
# D-channel IDs are resolved to user IDs at startup.
ALLOWED_DM_USERS=

# --- IP Allowlist ---
# Empty    = localhost only (default, most secure)
# 0.0.0.0  = allow everyone (use only behind a trusted reverse proxy)
# Supports single IPs and CIDR ranges, comma-separated
# Example: ALLOWED_IPS=100.64.0.0/10,192.168.64.1,203.0.113.50

# ALLOWED_IPS=

# --- Network ---

# 127.0.0.1 = localhost only (default, secure)
# 0.0.0.0   = exposed on network (use a strong API_KEY!)
BIND_ADDRESS=127.0.0.1
HOST_PORT=8282

# --- Write Operations ---

ENABLE_WRITE_OPS=false

# --- HTTPS ---

# Generate certs: ./scripts/generate-cert.sh
ENABLE_HTTPS=false
# HTTPS_KEY_PATH=/app/certs/server.key
# HTTPS_CERT_PATH=/app/certs/server.cert

# --- Persistent File Cache ---

# Enable JSONL-based persistent message cache (reduces Slack API calls)
ENABLE_PERSISTENT_CACHE=false
# Directory for cache files (relative to project root or absolute)
# PERSISTENT_CACHE_DIR=data
# Max messages to fetch per sync (delta fetch limit)
# PERSISTENT_CACHE_MAX_FETCH=200

# --- Swagger ---

# Set to false to disable /docs endpoint
ENABLE_SWAGGER=true
