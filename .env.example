# ===========================================
# Slack Personal Proxy - Environment Variables
# ===========================================

# --- Slack Authentication (pick one method) ---

# Method A: Cookie-based (personal use)
# Get these from Chrome DevTools on app.slack.com
SLACK_COOKIE=xoxd-your-cookie-here
SLACK_TOKEN=xoxc-your-token-here

# Method B: Bot token (approved Slack app)
# SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# --- API Security ---

# API key for authenticating requests to this proxy
API_KEY=your-secure-api-key-here

# --- Server ---

PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# --- Rate Limiting ---

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# --- Caching ---

ENABLE_CACHING=true
CHANNEL_CACHE_TTL_SECONDS=300
USER_CACHE_TTL_SECONDS=300
THREAD_CACHE_TTL_SECONDS=120
HEALTH_CACHE_TTL_SECONDS=300

# --- Pagination ---

MAX_PAGINATION_CALLS=10

# --- Whitelist (comma-separated channel names or IDs) ---
# This is the CORE feature of the proxy — only whitelisted channels are accessible.
# When set, ALL endpoints (channels list, messages, search, threads) are filtered.
# When empty, all channels are accessible (open mode).

ALLOWED_READ_CHANNELS=
ALLOWED_WRITE_CHANNELS=
ALLOWED_DM_CHANNELS=
ALLOWED_DM_USERS=

# --- Network ---

# 127.0.0.1 = localhost only (default, secure)
# 0.0.0.0   = exposed on network (use a strong API_KEY!)
BIND_ADDRESS=127.0.0.1
HOST_PORT=8282

# --- Write Operations ---

ENABLE_WRITE_OPS=false

# --- HTTPS ---

# Generate certs: ./scripts/generate-cert.sh
ENABLE_HTTPS=false
# HTTPS_KEY_PATH=/app/certs/server.key
# HTTPS_CERT_PATH=/app/certs/server.cert

# --- Swagger ---

# Set to false to disable /docs endpoint
ENABLE_SWAGGER=true
