#!/usr/bin/env bash
set -euo pipefail

# Resolve this script's own directory (following symlinks) so it works when called
# from anywhere, including via a global `slack-proxy` symlink. All docker compose and
# file paths are relative to the repo, so cd there first.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
cd "$SCRIPT_DIR"

CMD_NAME="$(basename "$0")"
COMPOSE_FILE="docker-compose.yml"
SERVICE_NAME="slack-personal-proxy"
NODE_IMAGE="node:20-alpine"

# Load .env for health check config
load_env() {
  if [ ! -f .env ]; then
    echo "ERROR: .env file not found. Copy .env.example and configure it:"
    echo "  cp .env.example .env"
    exit 1
  fi
  source .env
}

health_url() {
  local port="${HOST_PORT:-8282}"
  if [ "${ENABLE_HTTPS:-false}" = "true" ]; then
    echo "https://localhost:${port}/health"
  else
    echo "http://localhost:${port}/health"
  fi
}

curl_opts() {
  if [ "${ENABLE_HTTPS:-false}" = "true" ]; then
    echo "-sk"
  else
    echo "-s"
  fi
}

validate_env() {
  load_env
  if [ -z "${API_KEY:-}" ]; then
    echo "ERROR: API_KEY is not set in .env"
    exit 1
  fi
  if [ -z "${SLACK_BOT_TOKEN:-}" ] && { [ -z "${SLACK_COOKIE:-}" ] || [ -z "${SLACK_TOKEN:-}" ]; }; then
    echo "ERROR: No Slack credentials configured. Set SLACK_BOT_TOKEN or both SLACK_COOKIE and SLACK_TOKEN"
    exit 1
  fi
}

wait_healthy() {
  local url
  url=$(health_url)
  local opts
  opts=$(curl_opts)
  echo "Waiting for health check (${url})..."
  local retries=30
  while [ $retries -gt 0 ]; do
    STATUS=$(curl $opts -o /dev/null -w "%{http_code}" "$url" 2>/dev/null || echo "000")
    if [ "$STATUS" = "200" ]; then
      echo "Service is healthy!"
      return 0
    fi
    retries=$((retries - 1))
    sleep 1
  done
  echo "WARNING: Health check did not pass within 30 seconds."
  echo "Check logs: ${CMD_NAME} logs"
  return 1
}

show_status() {
  load_env
  local port="${HOST_PORT:-8282}"
  local scheme="http"
  local opts="-s"
  if [ "${ENABLE_HTTPS:-false}" = "true" ]; then
    scheme="https"
    opts="-sk"
  fi
  echo ""
  docker compose -f "$COMPOSE_FILE" ps
  echo ""
  echo "Service:   ${scheme}://localhost:${port}"
  echo "Health:    curl ${opts} ${scheme}://localhost:${port}/health"
  if [ "${ENABLE_DASHBOARD:-true}" != "false" ]; then
    echo "Dashboard: ${scheme}://localhost:${port}/dashboard"
  fi
}

ensure_certs() {
  if [ "${ENABLE_HTTPS:-false}" != "true" ]; then
    return
  fi
  if [ -f certs/server.key ] && [ -f certs/server.cert ]; then
    # Ensure certs are readable by Docker container (appuser UID 1001)
    if [ ! -r certs/server.key ] || [ "$(stat -c '%a' certs/server.key 2>/dev/null || stat -f '%Lp' certs/server.key)" != "644" ]; then
      echo "Fixing cert permissions..."
      chmod 644 certs/server.key certs/server.cert 2>/dev/null || sudo chmod 644 certs/server.key certs/server.cert
    fi
    return
  fi
  echo "HTTPS is enabled but certs are missing."
  echo "Generating self-signed certificate..."
  # Docker may have created certs/ as root via the volume mount
  if [ -d certs ] && [ ! -w certs ]; then
    echo "certs/ directory is not writable (owned by root from Docker)."
    echo "Fixing with sudo..."
    sudo chown -R "$(id -u):$(id -g)" certs
  fi
  mkdir -p certs
  TMPCONF=$(mktemp)
  cat > "$TMPCONF" <<CONF
[req]
default_bits = 2048
prompt = no
distinguished_name = dn
x509_extensions = v3_ext

[dn]
CN = slack-personal-proxy
O = Personal
C = US

[v3_ext]
subjectAltName = DNS:localhost,IP:127.0.0.1
CONF
  openssl req -x509 -newkey rsa:2048 -nodes \
    -keyout certs/server.key \
    -out certs/server.cert \
    -days 365 \
    -config "$TMPCONF" \
    || true
  rm -f "$TMPCONF"
  if [ -f certs/server.key ] && [ -f certs/server.cert ]; then
    chmod 644 certs/server.key certs/server.cert
    echo "Certs generated in certs/"
  else
    echo "ERROR: Failed to generate certs."
    echo "Try manually: ./scripts/generate-cert.sh"
    exit 1
  fi
}

cmd_start() {
  validate_env
  ensure_certs
  echo "Building and starting..."
  docker compose -f "$COMPOSE_FILE" up -d --build
  wait_healthy
  show_status
}

cmd_stop() {
  echo "Stopping..."
  docker compose -f "$COMPOSE_FILE" down
  echo "Stopped."
}

cmd_restart() {
  cmd_stop
  cmd_start
}

cmd_update() {
  echo "Pulling latest code..."
  git pull --ff-only
  cmd_restart
}

cmd_logs() {
  docker compose -f "$COMPOSE_FILE" logs -f "$@"
}

cmd_status() {
  load_env
  local url
  url=$(health_url)
  local opts
  opts=$(curl_opts)
  local http_code
  http_code=$(curl $opts -o /dev/null -w "%{http_code}" "$url" 2>/dev/null || echo "000")
  if [ "$http_code" = "200" ]; then
    echo "Status: running"
    show_status
  else
    echo "Status: not running (HTTP $http_code)"
  fi
}

# Generate a dashboard password hash INSIDE Docker (no host Node needed).
# Bind-mounts the repo into the node image and runs the existing hasher script.
cmd_hash_password() {
  local pw="${1:-}"
  echo "Generating dashboard password hash (via Docker)..."
  if [ -n "$pw" ]; then
    docker run --rm -v "$SCRIPT_DIR":/app -w /app "$NODE_IMAGE" \
      node scripts/set-dashboard-password.js "$pw"
  elif [ -t 0 ]; then
    docker run --rm -it -v "$SCRIPT_DIR":/app -w /app "$NODE_IMAGE" \
      node scripts/set-dashboard-password.js
  else
    echo "No password given and no interactive terminal."
    echo "Run: ${CMD_NAME} hash-password 'your-password'"
    exit 1
  fi
  echo ""
  echo "Paste the DASHBOARD_PASSWORD_HASH line above into your .env, then: ${CMD_NAME} restart"
}

# Install this script as a global `slack-proxy` command (symlink on PATH).
cmd_install() {
  local target="${1:-/usr/local/bin/slack-proxy}"
  local src="$SCRIPT_DIR/proxy"
  echo "Linking ${target} -> ${src}"
  if ln -sf "$src" "$target" 2>/dev/null; then
    :
  else
    echo "Elevated permissions needed for ${target}; using sudo..."
    sudo ln -sf "$src" "$target"
  fi
  echo "Installed. From now on, from any directory:"
  echo "  slack-proxy start | stop | restart | update | status | logs | hash-password"
}

cmd_help() {
  echo "Usage: ${CMD_NAME} <command>"
  echo ""
  echo "Commands:"
  echo "  start           Build, start, and wait for healthy"
  echo "  stop            Stop and remove container"
  echo "  restart         Stop then start (rebuilds the image)"
  echo "  update          git pull, then rebuild and restart"
  echo "  logs            Tail container logs (Ctrl-C to exit)"
  echo "  status          Check if service is running"
  echo "  hash-password   Generate a dashboard password hash (runs in Docker)"
  echo "  install [path]  Install as global 'slack-proxy' (default /usr/local/bin)"
  echo "  help            Show this help"
}

case "${1:-help}" in
  start)          cmd_start ;;
  stop)           cmd_stop ;;
  restart)        cmd_restart ;;
  update)         cmd_update ;;
  logs)           shift; cmd_logs "$@" ;;
  status)         cmd_status ;;
  hash-password)  shift || true; cmd_hash_password "${1:-}" ;;
  install)        shift || true; cmd_install "${1:-}" ;;
  help|*)         cmd_help ;;
esac
