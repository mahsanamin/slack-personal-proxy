#!/usr/bin/env bash
set -euo pipefail

# Resolve this script's own directory (following symlinks) so it works when called
# from anywhere, including via a global `slack-proxy` symlink. All docker compose and
# file paths are relative to the repo, so cd there first.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
cd "$SCRIPT_DIR"

CMD_NAME="$(basename "$0")"
COMPOSE_FILE="docker-compose.yml"
SERVICE_NAME="slack-personal-proxy"
NODE_IMAGE="node:20-alpine"

# Load .env for health-check config. Parse it LITERALLY (do not `source` it): values
# can contain '$', backticks, quotes (e.g. a password hash or passphrase), which shell
# sourcing would expand or execute and break under `set -u`.
load_env() {
  if [ ! -f .env ]; then
    echo "ERROR: .env file not found. Copy .env.example and configure it:"
    echo "  cp .env.example .env"
    exit 1
  fi
  local line key val
  while IFS= read -r line || [ -n "$line" ]; do
    # Skip blanks and comments
    [ -z "$line" ] && continue
    case "$line" in \#*) continue ;; esac
    # Split on the first '='
    key="${line%%=*}"
    val="${line#*=}"
    # Trim surrounding whitespace on the key; only accept valid identifiers
    key="${key#"${key%%[![:space:]]*}"}"
    key="${key%"${key##*[![:space:]]}"}"
    case "$key" in
      [A-Za-z_]*)
        [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        export "$key=$val"
        ;;
    esac
  done < .env
}

# The host to reach the published port on. When BIND_ADDRESS is a specific IP
# (e.g. a Tailscale address), the port is published ONLY on that IP, not on
# localhost, so health checks must target it. 0.0.0.0 / 127.0.0.1 / unset use localhost.
health_host() {
  local b="${BIND_ADDRESS:-127.0.0.1}"
  if [ -z "$b" ] || [ "$b" = "0.0.0.0" ] || [ "$b" = "127.0.0.1" ]; then
    echo "localhost"
  else
    echo "$b"
  fi
}

health_url() {
  local port="${HOST_PORT:-8282}"
  local host
  host=$(health_host)
  if [ "${ENABLE_HTTPS:-false}" = "true" ]; then
    echo "https://${host}:${port}/health"
  else
    echo "http://${host}:${port}/health"
  fi
}

validate_env() {
  load_env
  if [ -z "${API_KEY:-}" ]; then
    echo "ERROR: API_KEY is not set in .env"
    exit 1
  fi
  if [ -z "${SLACK_BOT_TOKEN:-}" ] && { [ -z "${SLACK_COOKIE:-}" ] || [ -z "${SLACK_TOKEN:-}" ]; }; then
    echo "ERROR: No Slack credentials configured. Set SLACK_BOT_TOKEN or both SLACK_COOKIE and SLACK_TOKEN"
    exit 1
  fi
}

# Check /health FROM INSIDE the container. This is reliable no matter how the port
# is published on the host (e.g. bound to a Tailscale IP, which the host itself often
# cannot curl back through Docker's port forwarding).
container_healthy() {
  local scheme="http" insecure=""
  if [ "${ENABLE_HTTPS:-false}" = "true" ]; then scheme="https"; insecure="--no-check-certificate"; fi
  docker compose -f "$COMPOSE_FILE" exec -T "$SERVICE_NAME" \
    wget -q $insecure -O /dev/null "${scheme}://localhost:3000/health" 2>/dev/null
}

wait_healthy() {
  local url
  url=$(health_url)
  echo "Waiting for health check..."
  local retries=30
  while [ $retries -gt 0 ]; do
    if container_healthy; then
      echo "Service is healthy!"
      echo "Reachable at: ${url}"
      return 0
    fi
    retries=$((retries - 1))
    sleep 1
  done
  echo "WARNING: Health check did not pass within 30 seconds."
  echo "Check logs: ${CMD_NAME} logs"
  return 1
}

show_status() {
  load_env
  local port="${HOST_PORT:-8282}"
  local scheme="http"
  local opts="-s"
  if [ "${ENABLE_HTTPS:-false}" = "true" ]; then
    scheme="https"
    opts="-sk"
  fi
  local host
  host=$(health_host)
  echo ""
  docker compose -f "$COMPOSE_FILE" ps
  echo ""
  echo "Service:   ${scheme}://${host}:${port}"
  echo "Health:    curl ${opts} ${scheme}://${host}:${port}/health"
  if [ "${ENABLE_DASHBOARD:-true}" != "false" ]; then
    echo "Dashboard: ${scheme}://${host}:${port}/dashboard"
  fi
}

ensure_certs() {
  if [ "${ENABLE_HTTPS:-false}" != "true" ]; then
    return
  fi
  if [ -f certs/server.key ] && [ -f certs/server.cert ]; then
    # Ensure certs are readable by Docker container (appuser UID 1001)
    if [ ! -r certs/server.key ] || [ "$(stat -c '%a' certs/server.key 2>/dev/null || stat -f '%Lp' certs/server.key)" != "644" ]; then
      echo "Fixing cert permissions..."
      chmod 644 certs/server.key certs/server.cert 2>/dev/null || sudo chmod 644 certs/server.key certs/server.cert
    fi
    return
  fi
  echo "HTTPS is enabled but certs are missing."
  echo "Generating self-signed certificate..."
  # Docker may have created certs/ as root via the volume mount
  if [ -d certs ] && [ ! -w certs ]; then
    echo "certs/ directory is not writable (owned by root from Docker)."
    echo "Fixing with sudo..."
    sudo chown -R "$(id -u):$(id -g)" certs
  fi
  mkdir -p certs
  TMPCONF=$(mktemp)
  cat > "$TMPCONF" <<CONF
[req]
default_bits = 2048
prompt = no
distinguished_name = dn
x509_extensions = v3_ext

[dn]
CN = slack-personal-proxy
O = Personal
C = US

[v3_ext]
subjectAltName = DNS:localhost,IP:127.0.0.1
CONF
  openssl req -x509 -newkey rsa:2048 -nodes \
    -keyout certs/server.key \
    -out certs/server.cert \
    -days 365 \
    -config "$TMPCONF" \
    || true
  rm -f "$TMPCONF"
  if [ -f certs/server.key ] && [ -f certs/server.cert ]; then
    chmod 644 certs/server.key certs/server.cert
    echo "Certs generated in certs/"
  else
    echo "ERROR: Failed to generate certs."
    echo "Try manually: ./scripts/generate-cert.sh"
    exit 1
  fi
}

# Ensure ./data exists and the container (run as the host user) can write to it.
ensure_data_dir() {
  mkdir -p data
  # If an earlier run left root/1001-owned files here, the host user can't write them.
  # Detect by trying to create a temp file, and reclaim ownership if that fails.
  if touch data/.wtest 2>/dev/null; then
    rm -f data/.wtest
  else
    echo "Reclaiming data/ ownership for the container..."
    sudo chown -R "$(id -u):$(id -g)" data || true
  fi
}

cmd_start() {
  validate_env
  ensure_certs
  ensure_data_dir
  # Run the container as the host user so the bind-mounted ./data is writable.
  export PUID="$(id -u)" PGID="$(id -g)"
  echo "Building and starting (as ${PUID}:${PGID})..."
  docker compose -f "$COMPOSE_FILE" up -d --build
  wait_healthy
  show_status
}

cmd_stop() {
  echo "Stopping..."
  docker compose -f "$COMPOSE_FILE" down
  echo "Stopped."
}

cmd_restart() {
  cmd_stop
  cmd_start
}

cmd_update() {
  echo "Pulling latest code..."
  git pull --ff-only
  cmd_restart
}

cmd_logs() {
  docker compose -f "$COMPOSE_FILE" logs -f "$@"
}

cmd_status() {
  load_env
  if container_healthy; then
    echo "Status: running and healthy"
    show_status
  else
    echo "Status: not healthy (checked /health inside the container)"
    echo "Check logs: ${CMD_NAME} logs"
  fi
}

# Generate a dashboard password hash INSIDE Docker (no host Node needed).
# Bind-mounts the repo into the node image and runs the existing hasher script.
cmd_hash_password() {
  local pw="${1:-}"
  echo "Generating dashboard password hash (via Docker)..."
  if [ -n "$pw" ]; then
    docker run --rm -v "$SCRIPT_DIR":/app -w /app "$NODE_IMAGE" \
      node scripts/set-dashboard-password.js "$pw"
  elif [ -t 0 ]; then
    docker run --rm -it -v "$SCRIPT_DIR":/app -w /app "$NODE_IMAGE" \
      node scripts/set-dashboard-password.js
  else
    echo "No password given and no interactive terminal."
    echo "Run: ${CMD_NAME} hash-password 'your-password'"
    exit 1
  fi
  echo ""
  echo "Paste the DASHBOARD_PASSWORD_HASH line above into your .env, then: ${CMD_NAME} restart"
}

# Install this script as a global `slack-proxy` command (symlink on PATH).
cmd_install() {
  local src="$SCRIPT_DIR/proxy"
  local target="${1:-}"

  # If no path given, pick the first sensible bin dir that is ON $PATH.
  if [ -z "$target" ]; then
    for d in "/usr/local/bin" "$HOME/.local/bin" "$HOME/bin" "/opt/homebrew/bin"; do
      case ":$PATH:" in *":$d:"*) target="$d/slack-proxy"; break ;; esac
    done
    # Nothing on PATH matched; fall back to /usr/local/bin and warn later.
    [ -z "$target" ] && target="/usr/local/bin/slack-proxy"
  fi

  local dir; dir="$(dirname "$target")"
  mkdir -p "$dir" 2>/dev/null || sudo mkdir -p "$dir"

  echo "Linking ${target} -> ${src}"
  if ln -sf "$src" "$target" 2>/dev/null; then
    :
  else
    echo "Elevated permissions needed for ${dir}; using sudo..."
    sudo ln -sf "$src" "$target"
  fi

  if [ ! -e "$target" ]; then
    echo "ERROR: could not create ${target}. Try: sudo ${CMD_NAME} install"
    exit 1
  fi

  echo "Installed at: ${target}"

  # Is that directory actually on PATH?
  case ":$PATH:" in
    *":$dir:"*)
      hash -r 2>/dev/null || true
      if command -v slack-proxy >/dev/null 2>&1; then
        echo "Ready. Run:  slack-proxy status"
      else
        echo "Linked, but the shell hasn't picked it up. Open a new terminal, or run:  hash -r"
      fi
      ;;
    *)
      echo ""
      echo "WARNING: ${dir} is not on your PATH, so 'slack-proxy' won't be found yet."
      echo "Add this to your ~/.zshrc (or ~/.bashrc), then open a new terminal:"
      echo "  export PATH=\"${dir}:\$PATH\""
      echo "Or reinstall into a dir already on PATH, e.g.:  ${CMD_NAME} install /usr/local/bin/slack-proxy"
      ;;
  esac
}

cmd_help() {
  echo "Usage: ${CMD_NAME} <command>"
  echo ""
  echo "Commands:"
  echo "  start           Build, start, and wait for healthy"
  echo "  stop            Stop and remove container"
  echo "  restart         Stop then start (rebuilds the image)"
  echo "  update          git pull, then rebuild and restart"
  echo "  logs            Tail container logs (Ctrl-C to exit)"
  echo "  status          Check if service is running"
  echo "  hash-password   Generate a dashboard password hash (runs in Docker)"
  echo "  install [path]  Install as global 'slack-proxy' (default /usr/local/bin)"
  echo "  help            Show this help"
}

case "${1:-help}" in
  start)          cmd_start ;;
  stop)           cmd_stop ;;
  restart)        cmd_restart ;;
  update)         cmd_update ;;
  logs)           shift; cmd_logs "$@" ;;
  status)         cmd_status ;;
  hash-password)  shift || true; cmd_hash_password "${1:-}" ;;
  install)        shift || true; cmd_install "${1:-}" ;;
  help|*)         cmd_help ;;
esac
